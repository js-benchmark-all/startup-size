{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "declaration": true,
    "plugins": [{ "transform": "typia/lib/transform" }]
  },
  "include": ["./schema.ts"]
}
